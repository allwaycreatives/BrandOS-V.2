// BrandOS — MVP data model (Sprint 1-2 scope)
// See Technical-Architecture-MVP.md Section 2 for the full rationale.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrgType {
  solo
  agency
}

enum MembershipRole {
  owner
  admin
  team_member
}

enum BrandSpaceRole {
  owner
  admin
  team_member
  client
  guest
}

model Organization {
  id          String        @id @default(cuid())
  name        String
  type        OrgType
  createdAt   DateTime      @default(now())
  memberships Membership[]
  brandSpaces BrandSpace[]
  templates Template[]
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String?
  authProviderId String?             @unique
  createdAt      DateTime            @default(now())
  memberships    Membership[]
  brandAccess    BrandSpaceAccess[]
  assignedTasks  Task[]
  comments       Comment[]
  notifications Notification[]
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

model BrandSpace {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?  // a founder's personal brand points at the shared brand it belongs to
  shareToken           String?  @unique // when set, anyone with the link can read the brand guide
  intakeToken          String?  @unique // when set, clients can send a brief through a public form
  planToken            String?  @unique // when set, anyone with the link can view the content plan and approve posts
  planNote             String?  // the "direction" note shown at the top of the client plan
  socialLinks          Json?    // the brand's social media and website links: [{platform, url}]
  strategy             Json?    // content strategy: mission, season, pillars, platform roles and targets, series
  name           String
  platformPriority Json?  // ordered array of platform names, e.g. ["Instagram","TikTok"]
  notionEmbedUrl String?
  createdAt      DateTime @default(now())

  organization        Organization         @relation(fields: [organizationId], references: [id])
  access               BrandSpaceAccess[]
  discoveryTemplates   DiscoveryTemplate[]
  discoveryResponses   DiscoveryResponse[]
  brandProfile         BrandProfile?
  brandKitItems        BrandKitItem[]
  projects             Project[]
  calendarItems        CalendarItem[]
  tasks                Task[]
  boards               Board[]
  invites              BrandSpaceInvite[]
  campaigns            Campaign[]
  ideas                Idea[]
  deliverables         Deliverable[]
  styleSummary         String?  // what this client likes and keeps changing
  styleSummaryAt       DateTime?
  parent               BrandSpace?  @relation("BrandFamily", fields: [parentId], references: [id], onDelete: SetNull)
  children             BrandSpace[] @relation("BrandFamily")
  faces                BrandFace[]  @relation("BrandFaces")
  facesLinkedHere      BrandFace[]  @relation("FacePersonalBrand")
}

// A person who represents a company brand (a founder, say). Their own personal brand is optional and
// comes later: personalBrandId is set when "Start their personal brand" is used. Deleting the company
// removes its faces; deleting a personal brand just clears the link.
model BrandFace {
  id              String   @id @default(cuid())
  brandSpaceId    String
  name            String
  role            String?
  personalBrandId String?
  createdAt       DateTime @default(now())

  brandSpace    BrandSpace  @relation("BrandFaces", fields: [brandSpaceId], references: [id], onDelete: Cascade)
  personalBrand BrandSpace? @relation("FacePersonalBrand", fields: [personalBrandId], references: [id], onDelete: SetNull)

  @@index([brandSpaceId])
}

model Board {
  id           String   @id @default(cuid())
  brandSpaceId String
  projectId    String?
  name         String   @default("Moodboard")
  shareToken   String?  @unique // when set, anyone with the link can view this board (read-only)
  parentBoardId String? // set when this board lives inside another board
  createdAt    DateTime @default(now())

  brandSpace BrandSpace  @relation(fields: [brandSpaceId], references: [id])
  cards      BoardCard[]
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent     Board?      @relation("BoardNesting", fields: [parentBoardId], references: [id], onDelete: SetNull)
  children   Board[]     @relation("BoardNesting")

  @@index([brandSpaceId])
}

model BoardCard {
  id        String   @id @default(cuid())
  boardId   String
  type      String   // note | image | link
  content   String
  positionX Float    @default(0)
  positionY Float    @default(0)
  meta      String?  // link cards: saved preview as JSON (title, image). null = not fetched yet, {} = nothing found
  width     Float?   // set when the card has been resized; null = the card's natural width
  height    Float?   // set when the card has been resized; null = height follows the content
  style     String?  // text and colour choices as JSON: size, bold, italic, alignment, colours, title, subtitle
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id])
}

model BrandSpaceAccess {
  id           String         @id @default(cuid())
  brandSpaceId String
  userId       String
  role         BrandSpaceRole
  canInvite    Boolean        @default(false) // owner can let a team member invite others

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([brandSpaceId, userId])
}

// --- Discovery (editable + versioned per Decisions 1, 7, 8) ---

model DiscoveryTemplate {
  id           String   @id @default(cuid())
  brandSpaceId String
  name         String
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(false)
  format       String   @default("quiz") // quiz | longform
  createdAt    DateTime @default(now())

  brandSpace BrandSpace                 @relation(fields: [brandSpaceId], references: [id])
  versions   DiscoveryTemplateVersion[]
}

model DiscoveryTemplateVersion {
  id             String   @id @default(cuid())
  templateId     String
  questionsJson  Json
  versionNumber  Int
  createdAt      DateTime @default(now())

  template  DiscoveryTemplate    @relation(fields: [templateId], references: [id])
  responses DiscoveryResponse[]
}

model DiscoveryResponse {
  id              String   @id @default(cuid())
  brandSpaceId    String
  templateVersionId String
  answersJson     Json
  submittedAt     DateTime @default(now())

  brandSpace      BrandSpace               @relation(fields: [brandSpaceId], references: [id])
  templateVersion DiscoveryTemplateVersion @relation(fields: [templateVersionId], references: [id])
  edits           DiscoveryResponseEdit[]
}

model DiscoveryResponseEdit {
  id                  String   @id @default(cuid())
  responseId          String
  previousAnswersJson Json
  editedAt            DateTime @default(now())

  response DiscoveryResponse @relation(fields: [responseId], references: [id])
}

// --- Brand identity output ---

model BrandProfile {
  id                  String   @id @default(cuid())
  brandSpaceId        String   @unique
  voiceSummary        String?
  audienceSummary     String?
  positioningSummary  String?
  derivedAt           DateTime @default(now())

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id])
}

model BrandKitItem {
  id            String   @id @default(cuid())
  brandSpaceId  String
  type          String   // 'bio' | 'tagline' | 'palette' | 'banner_spec'
  platform      String?
  contentJson   Json
  isSelected    Boolean  @default(false)
  versionNumber Int      @default(1)
  generatedAt   DateTime @default(now())

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id])
}

// --- Planning ---

model Project {
  id           String   @id @default(cuid())
  brandSpaceId String
  name         String
  description  String?
  status       String    @default("brief") // brief | in_progress | review | delivered
  dueDate      DateTime?
  brief        String?   // what the client wrote on the intake form
  briefFrom    String?   // who sent it, e.g. "Sam · sam@example.com"
  createdAt    DateTime @default(now())

  brandSpace    BrandSpace     @relation(fields: [brandSpaceId], references: [id])
  calendarItems CalendarItem[]
  tasks         Task[]
  boards        Board[]
  deliverables  Deliverable[]
}

model CalendarItem {
  id            String   @id @default(cuid())
  brandSpaceId  String
  projectId     String?
  campaignId    String?
  title         String
  platform      String
  status        String   @default("idea") // idea | planned | in_production | scheduled | published
  scheduledDate DateTime?
  assetUrl      String?
  hook          String?
  keyMessage    String?
  script        String?
  caption       String?
  thumbnailUrl  String?  // cover image shown next to the video on the client plan
  contentType   String?  // format: short_video | long_video | carousel | image | text | story | live | article
  priority      String   @default("normal") // high | normal | low
  productionDate DateTime? // when it is made; scheduledDate stays the PUBLISH date
  publishTime   String?  // optional time of day to publish, "HH:MM"
  pillar        String?  // a pillar name from the brand's content strategy
  series        String?  // a series name from the brand's content strategy
  hookOptions   String[] @default([]) // several hook ideas; `hook` holds the chosen one
  objective     String?  // what this piece is for and who it is for
  cta           String?  // call to action
  productionNotes String? // B-roll, filming, props, design notes
  successMetric String?  // how we will know it worked
  notes         String?  // team-only notes
  clientStatus  String   @default("pending") // pending | changes_requested | approved (what the client decided)
  createdAt     DateTime @default(now())

  brandSpace BrandSpace             @relation(fields: [brandSpaceId], references: [id])
  project    Project?               @relation(fields: [projectId], references: [id])
  campaign   Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  feedback   CalendarItemFeedback[]

  @@index([brandSpaceId])
}

// A comment, change request or approval from the client (or a team reply) on one planned post.
model CalendarItemFeedback {
  id         String   @id @default(cuid())
  itemId     String
  authorName String
  fromClient Boolean  @default(true)
  kind       String   // comment | changes_requested | approved
  body       String
  at         String?  // optional video timestamp, like "0:42"
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  item CalendarItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model Task {
  id             String    @id @default(cuid())
  brandSpaceId   String
  title          String
  description    String?
  fileUrl        String?   // e.g. a Google Drive share link, or the full video
  audioUrl       String?   // optional smaller audio-only file, used for transcription
  assigneeUserId String?
  campaignId     String?
  projectId      String?
  dueDate        DateTime?
  status         String    @default("open") // open | in_progress | done
  transcript     String?
  aiFeedback     String?
  clipSuggestions Json?
  createdAt      DateTime  @default(now())

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id])
  assignee   User?      @relation(fields: [assigneeUserId], references: [id])
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Comment {
  id           String   @id @default(cuid())
  brandSpaceId String
  objectType   String   // e.g. 'task' — extendable to other objects later
  objectId     String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())

  author User @relation(fields: [authorUserId], references: [id])
}

// A shareable invite link. The role is fixed here on the server, so nobody
// can change it by editing the URL. Set revokedAt to switch a link off.
model BrandSpaceInvite {
  id           String         @id @default(cuid())
  token        String         @unique
  brandSpaceId String
  role         BrandSpaceRole
  createdById  String
  createdAt    DateTime       @default(now())
  revokedAt    DateTime?

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id], onDelete: Cascade)

  @@index([brandSpaceId])
}

// A campaign groups content (calendar items, which move idea -> published) and tasks
// for one push, e.g. a launch. Deleting a campaign keeps its content and tasks.
model Campaign {
  id           String    @id @default(cuid())
  brandSpaceId String
  name         String
  goal         String?
  status       String    @default("planning") // planning | live | done
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  brandSpace    BrandSpace     @relation(fields: [brandSpaceId], references: [id])
  calendarItems CalendarItem[]
  tasks         Task[]

  @@index([brandSpaceId])
}

// A parked idea. Promoting it creates a campaign or project and marks it "promoted".
model Idea {
  id           String   @id @default(cuid())
  brandSpaceId String
  title        String
  notes        String?
  status       String   @default("open") // open | promoted | archived
  createdAt    DateTime @default(now())

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id])

  @@index([brandSpaceId])
}

// Something handed to a client for review: a link to a video, edit, design or document.
// We store the link, not the file. The client reviews through reviewToken, no account needed.
model Deliverable {
  id          String   @id @default(cuid())
  brandSpaceId String
  projectId   String?
  title       String
  url         String
  notes       String?
  status      String   @default("draft") // draft | in_review | changes_requested | approved
  version     Int      @default(1)
  reviewToken String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandSpace BrandSpace          @relation(fields: [brandSpaceId], references: [id])
  project    Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  feedback   DeliverableFeedback[]

  @@index([brandSpaceId])
}

// One comment, change request or approval. Kept forever so we learn what each client wants.
model DeliverableFeedback {
  id            String   @id @default(cuid())
  deliverableId String
  version       Int
  authorName    String
  fromClient    Boolean  @default(true)
  kind          String   // comment | changes_requested | approved
  body          String
  at            String?  // optional timestamp for video, like "0:42"
  pinX          Float?   // where on an image proof the comment was pinned: % from the left
  pinY          Float?   // % from the top
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
}

// An update for one person, like "Acme requested changes on Launch reel".
model Notification {
  id           String    @id @default(cuid())
  userId       String
  brandSpaceId String?
  title        String
  body         String?
  href         String
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// Your own reusable setup, saved from a board, campaign or project. Belongs to the workspace,
// so it can be used for any brand in it. payloadJson is a snapshot taken when it was saved.
model Template {
  id             String   @id @default(cuid())
  organizationId String
  kind           String   // board | campaign | project
  name           String
  payloadJson    Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
