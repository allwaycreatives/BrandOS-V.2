// BrandOS — MVP data model (Sprint 1-2 scope)
// See Technical-Architecture-MVP.md Section 2 for the full rationale.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrgType {
  solo
  agency
}

enum MembershipRole {
  owner
  admin
  team_member
}

enum BrandSpaceRole {
  owner
  admin
  team_member
  client
  guest
}

model Organization {
  id          String        @id @default(cuid())
  name        String
  type        OrgType
  createdAt   DateTime      @default(now())
  memberships Membership[]
  brandSpaces BrandSpace[]
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String?
  authProviderId String?             @unique
  createdAt      DateTime            @default(now())
  memberships    Membership[]
  brandAccess    BrandSpaceAccess[]
  assignedTasks  Task[]
  comments       Comment[]
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

model BrandSpace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  platformPriority Json?  // ordered array of platform names, e.g. ["Instagram","TikTok"]
  notionEmbedUrl String?
  createdAt      DateTime @default(now())

  organization        Organization         @relation(fields: [organizationId], references: [id])
  access               BrandSpaceAccess[]
  discoveryTemplates   DiscoveryTemplate[]
  discoveryResponses   DiscoveryResponse[]
  brandProfile         BrandProfile?
  brandKitItems        BrandKitItem[]
  projects             Project[]
  calendarItems        CalendarItem[]
  tasks                Task[]
  boards               Board[]
  invites              BrandSpaceInvite[]
  campaigns            Campaign[]
}

model Board {
  id           String   @id @default(cuid())
  brandSpaceId String
  projectId    String?
  name         String   @default("Moodboard")
  shareToken   String?  @unique // when set, anyone with the link can view this board (read-only)
  createdAt    DateTime @default(now())

  brandSpace BrandSpace  @relation(fields: [brandSpaceId], references: [id])
  cards      BoardCard[]
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model BoardCard {
  id        String   @id @default(cuid())
  boardId   String
  type      String   // note | image | link
  content   String
  positionX Float    @default(0)
  positionY Float    @default(0)
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id])
}

model BrandSpaceAccess {
  id           String         @id @default(cuid())
  brandSpaceId String
  userId       String
  role         BrandSpaceRole
  canInvite    Boolean        @default(false) // owner can let a team member invite others

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([brandSpaceId, userId])
}

// --- Discovery (editable + versioned per Decisions 1, 7, 8) ---

model DiscoveryTemplate {
  id           String   @id @default(cuid())
  brandSpaceId String
  name         String
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(false)
  format       String   @default("quiz") // quiz | longform
  createdAt    DateTime @default(now())

  brandSpace BrandSpace                 @relation(fields: [brandSpaceId], references: [id])
  versions   DiscoveryTemplateVersion[]
}

model DiscoveryTemplateVersion {
  id             String   @id @default(cuid())
  templateId     String
  questionsJson  Json
  versionNumber  Int
  createdAt      DateTime @default(now())

  template  DiscoveryTemplate    @relation(fields: [templateId], references: [id])
  responses DiscoveryResponse[]
}

model DiscoveryResponse {
  id              String   @id @default(cuid())
  brandSpaceId    String
  templateVersionId String
  answersJson     Json
  submittedAt     DateTime @default(now())

  brandSpace      BrandSpace               @relation(fields: [brandSpaceId], references: [id])
  templateVersion DiscoveryTemplateVersion @relation(fields: [templateVersionId], references: [id])
  edits           DiscoveryResponseEdit[]
}

model DiscoveryResponseEdit {
  id                  String   @id @default(cuid())
  responseId          String
  previousAnswersJson Json
  editedAt            DateTime @default(now())

  response DiscoveryResponse @relation(fields: [responseId], references: [id])
}

// --- Brand identity output ---

model BrandProfile {
  id                  String   @id @default(cuid())
  brandSpaceId        String   @unique
  voiceSummary        String?
  audienceSummary     String?
  positioningSummary  String?
  derivedAt           DateTime @default(now())

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id])
}

model BrandKitItem {
  id            String   @id @default(cuid())
  brandSpaceId  String
  type          String   // 'bio' | 'tagline' | 'palette' | 'banner_spec'
  platform      String?
  contentJson   Json
  isSelected    Boolean  @default(false)
  versionNumber Int      @default(1)
  generatedAt   DateTime @default(now())

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id])
}

// --- Planning ---

model Project {
  id           String   @id @default(cuid())
  brandSpaceId String
  name         String
  description  String?
  status       String    @default("brief") // brief | in_progress | review | delivered
  dueDate      DateTime?
  createdAt    DateTime @default(now())

  brandSpace    BrandSpace     @relation(fields: [brandSpaceId], references: [id])
  calendarItems CalendarItem[]
  tasks         Task[]
  boards        Board[]
}

model CalendarItem {
  id            String   @id @default(cuid())
  brandSpaceId  String
  projectId     String?
  campaignId    String?
  title         String
  platform      String
  status        String   @default("idea") // idea | planned | in_production | scheduled | published
  scheduledDate DateTime?
  assetUrl      String?
  hook          String?
  keyMessage    String?
  script        String?
  caption       String?
  createdAt     DateTime @default(now())

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id])
  project    Project?   @relation(fields: [projectId], references: [id])
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

model Task {
  id             String    @id @default(cuid())
  brandSpaceId   String
  title          String
  description    String?
  fileUrl        String?   // e.g. a Google Drive share link, or the full video
  audioUrl       String?   // optional smaller audio-only file, used for transcription
  assigneeUserId String?
  campaignId     String?
  projectId      String?
  dueDate        DateTime?
  status         String    @default("open") // open | in_progress | done
  transcript     String?
  aiFeedback     String?
  clipSuggestions Json?
  createdAt      DateTime  @default(now())

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id])
  assignee   User?      @relation(fields: [assigneeUserId], references: [id])
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Comment {
  id           String   @id @default(cuid())
  brandSpaceId String
  objectType   String   // e.g. 'task' — extendable to other objects later
  objectId     String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())

  author User @relation(fields: [authorUserId], references: [id])
}

// A shareable invite link. The role is fixed here on the server, so nobody
// can change it by editing the URL. Set revokedAt to switch a link off.
model BrandSpaceInvite {
  id           String         @id @default(cuid())
  token        String         @unique
  brandSpaceId String
  role         BrandSpaceRole
  createdById  String
  createdAt    DateTime       @default(now())
  revokedAt    DateTime?

  brandSpace BrandSpace @relation(fields: [brandSpaceId], references: [id], onDelete: Cascade)

  @@index([brandSpaceId])
}

// A campaign groups content (calendar items, which move idea -> published) and tasks
// for one push, e.g. a launch. Deleting a campaign keeps its content and tasks.
model Campaign {
  id           String    @id @default(cuid())
  brandSpaceId String
  name         String
  goal         String?
  status       String    @default("planning") // planning | live | done
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  brandSpace    BrandSpace     @relation(fields: [brandSpaceId], references: [id])
  calendarItems CalendarItem[]
  tasks         Task[]

  @@index([brandSpaceId])
}
